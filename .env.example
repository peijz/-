# DeepSeek
DEEPSEEK_API_KEY=

# Tavily Web Search
TAVILY_API_KEY=

# MiniMax（主 LLM + embedding 共用）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# Embedding 端点（默认即可；如走网关有问题再覆盖）
MINIMAX_EMBED_URL=https://api.minimax.chat/v1/embeddings
MINIMAX_EMBED_MODEL=embo-01
# Chat 模型 + 温度（按需切换，不必改代码）
MINIMAX_CHAT_MODEL=MiniMax-M3
MINIMAX_TEMPERATURE=0.6

# LangSmith（生产环境建议关闭 tracing 或使用独立项目）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=zhongyiguan-prod

# MySQL
DB_URL=mysql+pymysql://<user>:<password>@<host>:3306/zhongyiguan?charset=utf8mb4

# Redis（长期记忆向量库 + Agent checkpointer 共用）
REDIS_URL=redis://<host>:6379/0

# Checkpointer 选型：redis（默认，多 worker 共享）| memory（单进程开发用）
APP_CHECKPOINTER=redis

# 运行时配置
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8005
APP_WORKERS=2
APP_RELOAD=false

# JWT 签名密钥（生产必填，dev 可缺）
#   生成: openssl rand -hex 32
#   要求: 长度 ≥ 32 字符；切勿 commit 到 git
JWT_SECRET=
